# ============================================
# 项目管理工具 - 服务器环境配置模板
# ============================================
# 使用方法：复制此文件为 .env 并填入实际值
# 首次初始化后可直接用：
#   npm run env:local
#   npm run env:prod -- --origin=https://app.example.com --api=/api

# ─── 服务器配置 ───────────────────────────
PORT=3001
# 生产环境必须显式设置为 production，否则服务拒绝启动
NODE_ENV=development

# ─── 开发模式配置（仅 NODE_ENV=development 生效）────
# 本地调试时，无 Token 请求会使用此 UUID 作为当前用户
# 请填写你在 Supabase 中实际存在的用户 ID（不要硬编码到代码里）
DEV_USER_ID=YOUR_LOCAL_USER_UUID_HERE

# ─── Supabase 配置 ────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ─── CORS 配置 ───────────────────────────
# 本地联调示例：
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 生产环境示例：
# CORS_ORIGIN=https://app.example.com

# ─── JWT 配置 ─────────────────────────────
# 必须使用强随机密钥（32+字符）
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=7d

# ─── 日志配置 ─────────────────────────────
LOG_LEVEL=info

# ─── 数据库直连配置（用于迁移脚本）───────
# 生产建议配置 Supabase pooler/session 连接串。官方日历年度导入会优先使用
# DB_CONNECTION_STRING / SUPABASE_MIGRATION_URL 走 PostgreSQL 事务发布，避免 REST key 兼容问题。
# 示例：
# DB_CONNECTION_STRING=postgresql://postgres.<tenant-or-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_MIGRATION_URL=postgresql://postgres.<tenant-or-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DB_CONNECTION_STRING=
SUPABASE_MIGRATION_URL=
DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

# ─── 官方工作日历导入 ───────────────────
# 可选：强制官方日历导入走 PostgreSQL 发布路径。
OFFICIAL_WORK_CALENDAR_DB_DRIVER=postgres
OFFICIAL_WORK_CALENDAR_DB_TIMEOUT_MS=12000
OFFICIAL_HOLIDAY_NOTICE_FETCH_TIMEOUT_MS=15000

# --- Weather forecast lookup ---
# Default: query public web weather at use time; no authorized key is required.
# Weather facts are fetched only during project climate/weather refresh and written to project_weather_forecasts.
WEATHER_LOOKUP_PROVIDER=cma_public_weather
# Default fallback chain keeps mainland CMA first, then optional authorized/configured channels, then web lookup.
WEATHER_LOOKUP_PROVIDER_FALLBACKS=cma_public_weather,smartweatherapi,generic,on_demand_web
WEATHER_LOOKUP_USER_AGENT=WorkBuddy/1.0 weather-lookup
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
ON_DEMAND_WEATHER_FORECAST_DAYS=10
PROJECT_WEATHER_SYNC_INTERVAL_HOURS=3

# Optional enterprise authorized channel. Set WEATHER_LOOKUP_PROVIDER=smartweatherapi if the company later buys this service.
OFFICIAL_WEATHER_PROVIDER=
OFFICIAL_WEATHER_USER_AGENT=WorkBuddy/1.0 weather-lookup
SMARTWEATHER_API_BASE_URL=https://open.weather.com.cn/data/
SMARTWEATHER_API_TYPE=forecast_f
SMARTWEATHER_API_APP_ID=
SMARTWEATHER_API_PRIVATE_KEY=
# Example: {"310000":"101020100","上海市":"101020100","北京市":"101010100"}
OFFICIAL_WEATHER_AREA_ID_MAP_JSON={}
# Default mainland public weather source; station ids can be omitted for built-in priority cities.
# Example: {"310000":"58367","上海市":"58367","北京市":"54511"}
OFFICIAL_WEATHER_STATION_ID_MAP_JSON={}
CMA_PUBLIC_WEATHER_BASE_URL=https://weather.cma.cn/api/weather/view
