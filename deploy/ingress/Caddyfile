{
	admin off
	auto_https disable_redirects
}

(workbuddy_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(workbuddy_upstream_error_response) {
	handle_errors {
		import workbuddy_security_headers
		respond "" {err.status_code}
	}
}

http://{$PRODUCTION_HOST} {
	redir https://{$PRODUCTION_HOST}{uri} 308
}

http://{$STAGING_HOST} {
	redir https://{$STAGING_HOST}{uri} 308
}

https://{$PRODUCTION_HOST} {
	import workbuddy_security_headers
	import workbuddy_upstream_error_response
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

https://{$STAGING_HOST} {
	import workbuddy_security_headers
	import workbuddy_upstream_error_response
	encode zstd gzip
	reverse_proxy 127.0.0.1:8081
}
