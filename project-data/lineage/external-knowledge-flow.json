{
  "schemaVersion": "workbuddy-data-external-knowledge-flow/v1",
  "mutationBoundary": "lineage_only_no_db_mutation_no_runtime_write",
  "flow": [
    "project-search source/document/candidate evidence",
    "project-search knowledge-base candidate cards",
    "code-owner review and conflict decision",
    "official seed rule or template source change",
    "automated code and generation-quality tests",
    "normal application release",
    "runtime learning remains separate and consumes only real product facts and outcomes"
  ]
}
