{
  "schemaVersion": "workbuddy-runtime-writer-contract/v1",
  "writerId": "t2_rhythm_schedule_runtime_publication_service",
  "mutationBoundary": "contract_only_no_db_mutation_no_runtime_write",
  "allowedMode": "runtime_publication_approval_required",
  "requiresUnlock": true,
  "mayWriteBusinessFacts": true,
  "mayWriteRuntimeAssets": true,
  "productionAllowed": false,
  "allowedTables": [
    "tasks",
    "task_dependencies",
    "runtime_publication_tables"
  ],
  "forbiddenTables": [
    "task_baselines",
    "monthly_plans",
    "monthly_plan_items",
    "duration_experience_samples",
    "actual_duration_outcomes",
    "critical_path",
    "production_seed_rows"
  ],
  "requiredEvidence": [
    "runtime_publication_approval",
    "manual_runtime_publication_approval",
    "dependency_write_approval",
    "plan_date_write_approval",
    "rollback_target",
    "rollback_evidence_refs"
  ]
}
